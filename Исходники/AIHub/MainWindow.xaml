                        <TextBlock x:Name="SettingsLanguageTitleText"
                                   Text="Язык интерфейса"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource UiSectionFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsLanguageHelpText"
                                   Text="Можно выбрать встроенный язык или добавить свой JSON-файл перевода в папку локализации пользователя."
