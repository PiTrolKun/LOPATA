<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Product>LOPATA</Product>
    <Title>LOPATA</Title>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AIHubVersion Condition="'$(AIHubVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\VERSION').Trim())</AIHubVersion>
    <AIHubNumericVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(AIHubVersion)', '-.*$', ''))</AIHubNumericVersion>
    <Version>$(AIHubVersion)</Version>
    <AssemblyVersion>$(AIHubNumericVersion).0</AssemblyVersion>
    <FileVersion>$(AIHubNumericVersion).0</FileVersion>
    <InformationalVersion>$(AIHubVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Speech" Version="10.0.9" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\lopata_brand.png" />
    <Content Include="Licenses\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\giga-manifest.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\..\Каталоги\huggingface-catalog-seed.json" Link="Catalogs\huggingface-catalog-seed.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Каталоги\Рабочие_паттерны\work-patterns.json" Link="Catalogs\WorkPatterns\work-patterns.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\libespeak-ng.dll" Link="VoiceRuntime\eSpeakNG\libespeak-ng.dll" Condition="Exists('..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\libespeak-ng.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\espeak-ng-data\**\*" Link="VoiceRuntime\eSpeakNG\espeak-ng-data\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\espeak-ng-data')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
