    <Compile Include="../../Исходники/AIHub/Services/AudioConversionMetadata.cs" Link="Shared/AudioConversionMetadata.cs" />
    <Compile Include="../../Исходники/AIHub/Services/AudioMetadataArchive.cs" Link="Shared/AudioMetadataArchive.cs" />
    <Compile Include="../../Исходники/AIHub/Services/PngTextMetadata.cs" Link="Shared/PngTextMetadata.cs" />
