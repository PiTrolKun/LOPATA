<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ReaderResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ReaderText}"/>
        <Setter Property="Background" Value="{DynamicResource ReaderPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReaderLine}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Frame" Background="Transparent" CornerRadius="4" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" Margin="0,1,8,0" VerticalAlignment="Top">
                            <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"/>
                            <Ellipse x:Name="Dot" Fill="{DynamicResource AccentBrush}" Margin="4" Visibility="Hidden"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ReaderHover}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ReaderHover}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
