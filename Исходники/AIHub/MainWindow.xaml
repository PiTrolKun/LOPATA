                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont12}"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding SourceText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont11}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,14,0" />
