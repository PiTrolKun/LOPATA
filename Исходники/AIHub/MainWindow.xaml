                                  Width="300"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="ModelDownloadConnectionsComboBox_SelectionChanged" />
                    </StackPanel>
                </Border>

