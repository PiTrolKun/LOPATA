                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont11}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,14,0" />
                                                <TextBlock Text="{Binding PathText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont11}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,14,0" />
