                                                    <Button Content="{Binding RemoveLabel}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="10,5"
                                                            Margin="6,0,0,0"
                                                            Tag="{Binding}"
                                                            IsEnabled="{Binding CanRemove}"
                                                            Click="ComponentRemoveButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button x:Name="DownloadSelectedComponentsButton"
                                    Content="Скачать выбранные"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="DownloadSelectedComponentsButton_Click" />
                            <Button x:Name="DownloadAllComponentsButton"
                                    Content="Скачать все доступные"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="DownloadAllComponentsButton_Click" />
                            <Button x:Name="VerifyInstalledComponentsButton"
                                    Content="Проверить установленные"
