                                           VerticalAlignment="Center" />
                                <TextBox x:Name="ResultsTotalLimitInput"
                                         Grid.Column="1"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center" />
                                <CheckBox x:Name="ResultsAllowOverflowCheckBox"
