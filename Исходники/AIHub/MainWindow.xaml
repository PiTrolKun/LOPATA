                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="ImageAnalysisScenarioTitleText"
                                       Text="Анализ изображений"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiCardTitleFontSize}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ImageAnalysisScenarioDescriptionText"
                                       Text="Профильный сценарий для исследования изображений с комплектом моделей, подобранным под мощность компьютера."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiBodyFontSize}"
                                       LineHeight="{DynamicResource UiLineHeight22}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,20,0" />
                        </StackPanel>

                        <Button x:Name="SelectImageAnalysisButton"
                                Grid.Column="1"
                                Content="Выбрать сценарий"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="148"
                                VerticalAlignment="Bottom"
                                Click="SelectImageAnalysisButton_Click" />
                    </Grid>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="{DynamicResource UiCardPadding}"
                        HorizontalAlignment="Stretch" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="LiteraryScenarioTitleText"
                                       Text="Литературная работа"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiCardTitleFontSize}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="LiteraryScenarioDescriptionText"
                                       Text="Создавайте и развивайте произведения с помощью ИИ: от первых идей до больших историй."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiBodyFontSize}"
                                       LineHeight="{DynamicResource UiLineHeight22}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,20,0" />
                        </StackPanel>

                        <Button x:Name="SelectLiteraryScenarioButton"
                                Grid.Column="1"
                                Content="Выбрать сценарий"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="148"
                                VerticalAlignment="Bottom"
                                Click="SelectLiteraryScenarioButton_Click" />
                    </Grid>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="{DynamicResource UiCardPadding}"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="ReasoningModeTitleText"
                                       Text="Песочница"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiCardTitleFontSize}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ReasoningModeDescriptionText"
                                       Text="Экспериментально проверить возможности ЛОПАТА: собрать вводные, подобрать координатора и доступные инструменты."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiBodyFontSize}"
                                       LineHeight="{DynamicResource UiLineHeight22}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,20,0" />
                        </StackPanel>

                        <Button x:Name="SelectReasoningModeButton"
                                Grid.Column="1"
                                Content="Выбрать режим"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="132"
                                VerticalAlignment="Bottom"
                                Click="SelectReasoningModeButton_Click" />
                    </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Expander x:Name="PreviousWorkExpander"
                      Grid.Row="4"
                      IsExpanded="False"
                      VerticalAlignment="Stretch"
                      Expanded="PreviousWorkExpander_Expanded"
                      Collapsed="PreviousWorkExpander_Collapsed">
                <Expander.Header>
                    <TextBlock x:Name="PreviousWorkHeaderText"
                               Text="Ранее начатое"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{DynamicResource UiFont16}"
                               FontWeight="SemiBold" />
                </Expander.Header>

                <Grid Margin="0,12,0,0"
                      MaxWidth="960"
                      HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PreviousWorkSelectionPanel"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="PreviousWorkSelectionCountText"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left" />
                            <Button x:Name="ClearPreviousWorkSelectionButton"
                                    Content="Снять выбор"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32"
                                    MinWidth="104"
                                    Padding="12,0"
                                    Margin="12,0,0,0"
                                    DockPanel.Dock="Right"
                                    Click="ClearPreviousWorkSelectionButton_Click" />
                            <Button x:Name="DeletePreviousWorkSelectionButton"
                                    Content="Удалить"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32"
                                    MinWidth="92"
                                    Padding="12,0"
                                    Margin="8,0,0,0"
                                    DockPanel.Dock="Right"
                                    Click="DeletePreviousWorkSelectionButton_Click" />
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="PreviousWorkEmptyText"
                               Grid.Row="1"
                               Text="Сохранённых сессий пока нет."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource UiFont14}"
                               Margin="4,12,0,0"
                               Visibility="Collapsed" />

                    <ScrollViewer x:Name="PreviousWorkScrollViewer"
                                  Grid.Row="1"
                                  MaxHeight="{DynamicResource UiPreviousWorkMaxHeight}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ItemsControl x:Name="PreviousWorkItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Top"
                                                      Margin="0,4,12,0"
                                                      Click="PreviousWorkSelectionCheckBox_Click" />

                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding DisplayTitle, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsTitleReadOnly}"
                                                             Tag="{Binding}"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0"
                                                             FontSize="{DynamicResource UiFont16}"
                                                             FontWeight="SemiBold"
                                                             MaxLength="100"
                                                             VerticalContentAlignment="Center"
                                                             KeyDown="PreviousWorkTitleTextBox_KeyDown"
                                                             LostKeyboardFocus="PreviousWorkTitleTextBox_LostKeyboardFocus" />
                                                    <Button Grid.Column="1"
                                                            Content="✎"
                                                            Tag="{Binding}"
                                                            IsEnabled="{Binding CanResume}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Width="32"
                                                            Height="32"
                                                            MinWidth="32"
                                                            Padding="0"
                                                            Margin="8,-4,8,0"
                                                            FontFamily="Segoe UI Symbol, Segoe UI"
                                                            ToolTip="{Binding RenameTooltip}"
                                                            Click="RenamePreviousWorkButton_Click" />
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding CreatedText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont12}"
                                                           Margin="0,7,16,0" />
                                                <StackPanel Grid.Row="2"
                                                            Orientation="Horizontal"
                                                            Margin="0,3,16,0">
                                                    <TextBlock Text="{Binding UpdatedText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource UiFont12}" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="{DynamicResource UiFont12}"
                                                               FontWeight="SemiBold"
                                                               Margin="14,0,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <Button Grid.Column="2"
                                                    Tag="{Binding}"
                                                    Content="{Binding PrimaryActionText}"
                                                    IsEnabled="{Binding CanResume}"
                                                    MinWidth="136"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="PreviousWorkPrimaryActionButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource SecondaryButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RequiresExecutorDownload}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="BorderBrush"
                                                                        Value="{DynamicResource AccentBrush}" />
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever"
                                                                                    AutoReverse="True">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="1"
                                                                                             To="0.62"
                                                                                             Duration="0:0:0.85" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Expander>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BackFromWorkStartButton"
                        Content="Назад"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackFromWorkStartButton_Click" />
            </StackPanel>
        </Grid>

        <controls:ImageAnalysisBundleSelectorControl
            x:Name="ImageAnalysisBundleSelectorPage"
            Grid.Row="1"
            Margin="{DynamicResource UiImagePageMargin}"
            MaxWidth="{DynamicResource UiBundleContentMaxWidth}"
            HorizontalAlignment="Center"
            Visibility="Collapsed"
            BackRequested="ImageAnalysisBundleSelectorPage_BackRequested"
            BundleSelected="ImageAnalysisBundleSelectorPage_BundleSelected"
            UnavailableBundleRequested="ImageAnalysisBundleSelectorPage_UnavailableBundleRequested" />

        <controls:ImageAnalysisBundleConfirmationControl
            x:Name="ImageAnalysisBundleConfirmationPage"
            Grid.Row="1"
            Margin="56,34,56,36"
            Visibility="Collapsed"
            BackToBundlesRequested="ImageAnalysisBundleConfirmationPage_BackToBundlesRequested"
            BackToWorkStartRequested="ImageAnalysisBundleConfirmationPage_BackToWorkStartRequested"
            ActionRequested="ImageAnalysisBundleConfirmationPage_ActionRequested"
            RemoveVisionRequested="ImageAnalysisBundleConfirmationPage_RemoveVisionRequested"
            CancelRequested="ImageAnalysisBundleConfirmationPage_CancelRequested"
            ViewHistoryRequested="ImageAnalysisBundleConfirmationPage_ViewHistoryRequested" />

        <controls:ImageAnalysisWorkspaceControl
            x:Name="ImageAnalysisWorkspacePage"
            Grid.Row="1"
            Margin="56,34,56,36"
            Visibility="Collapsed"
            BackRequested="ImageAnalysisWorkspacePage_BackRequested"
            SingleSubscenarioRequested="ImageAnalysisWorkspacePage_SingleSubscenarioRequested"
            SelectImageRequested="ImageAnalysisWorkspacePage_SelectImageRequested"
            GenerateRequested="ImageAnalysisWorkspacePage_GenerateRequested"
            DraftSettingsChanged="ImageAnalysisWorkspacePage_DraftSettingsChanged"
            ReviseRequested="ImageAnalysisWorkspacePage_ReviseRequested"
            PreviewRequested="ImageAnalysisWorkspacePage_PreviewRequested"
            ExportRequested="ImageAnalysisWorkspacePage_ExportRequested"
            CompleteRequested="ImageAnalysisWorkspacePage_CompleteRequested"
            CancelRequested="ImageAnalysisWorkspacePage_CancelRequested"
            ResumeRequested="ImageAnalysisWorkspacePage_ResumeRequested"
            VersionRequested="ImageAnalysisWorkspacePage_VersionRequested"
            HomeRequested="ImageAnalysisWorkspacePage_HomeRequested"
            NewAnalysisRequested="ImageAnalysisWorkspacePage_NewAnalysisRequested"
            SpeechModeRequested="ImageAnalysisWorkspacePage_SpeechModeRequested"
            SpeechSettingsChanged="ImageAnalysisWorkspacePage_SpeechSettingsChanged"
            OmniSpeakerChanged="ImageAnalysisWorkspacePage_OmniSpeakerChanged"
            KokoroDownloadRequested="ImageAnalysisWorkspacePage_KokoroDownloadRequested"
            ReplaySpeechRequested="ImageAnalysisWorkspacePage_ReplaySpeechRequested" />

        <Grid x:Name="ChoiceScenarioPage"
              Grid.Row="1"
              Margin="56,34,56,26"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="ChoiceScenarioTitleText"
                           Text="Песочница"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{DynamicResource UiFont32}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ChoiceScenarioDescriptionText"
                           Text="Экспериментальная среда без гарантии полного выполнения задачи."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource UiFont15}"
                           LineHeight="{DynamicResource UiLineHeight24}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>

            <Viewbox x:Name="ChoiceScenarioPreparationViewbox"
                     Grid.Row="2"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <StackPanel Width="960">
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="22"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBlock x:Name="ChoiceScenarioQuestionMeasureText"
                                               Text="К чему ближе вопрос?"
                                               Foreground="Transparent"
                                               FontSize="{DynamicResource UiFont22}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               IsHitTestVisible="False" />
                                    <TextBlock x:Name="ChoiceScenarioQuestionText"
                                               Text="К чему ближе вопрос?"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="{DynamicResource UiFont22}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Button x:Name="CoreVoiceToggleButton"
                                        Grid.Column="1"
                                        Content="🔊"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="42"
                                        Height="36"
                                        MinWidth="42"
                                        Padding="0"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Top"
                                        Click="CoreVoiceToggleButton_Click" />
                            </Grid>
                            <TextBlock x:Name="ChoiceScenarioStatusText"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       LineHeight="{DynamicResource UiLineHeight21}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,14" />

                            <Border x:Name="ChoiceScenarioCoreThoughtPanel"
                                    Background="{DynamicResource StepBadgeBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="ChoiceScenarioCoreThoughtTitleText"
                                               Text="Мысль ядра"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="{DynamicResource UiFont13}"
                                               FontWeight="SemiBold" />
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock x:Name="ChoiceScenarioCoreThoughtMeasureText"
                                                   Text="Сначала определим крупную область вопроса, а потом сузим направление."
                                                   Foreground="Transparent"
                                                   FontSize="{DynamicResource UiFont13}"
                                                   LineHeight="{DynamicResource UiLineHeight21}"
                                                   TextWrapping="Wrap"
                                                   IsHitTestVisible="False" />
                                        <TextBlock x:Name="ChoiceScenarioCoreThoughtText"
                                                   Text="Сначала определим крупную область вопроса, а потом сузим направление."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="{DynamicResource UiFont13}"
                                                   LineHeight="{DynamicResource UiLineHeight21}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ChoiceSessionFilesPanel"
                                    Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,14"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="ChoiceSessionFilesTitleText"
                                               Text="Файлы в этой сессии"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="{DynamicResource UiFont13}"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,6" />
                                    <ItemsControl x:Name="ChoiceSessionFilesItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="286"
                                                        MinHeight="58"
                                                        Background="{DynamicResource PanelBrush}"
                                                        BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="9"
                                                        Margin="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="{DynamicResource UiFont12}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Details}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       FontSize="{DynamicResource UiFont11}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding AvailabilityText}"
                                                                       FontSize="{DynamicResource UiFont10}"
                                                                       Margin="0,3,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource AccentBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAvailable}"
                                                                                         Value="False">
                                                                                <Setter Property="Foreground"
                                                                                        Value="#EF4444" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="×"
                                                                Tag="{Binding Id}"
                                                                ToolTip="{Binding RemoveTooltip}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Width="28"
                                                                Height="28"
                                                                MinWidth="28"
                                                                Padding="0"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Top"
                                                                Click="SessionFileRemoveButton_Click" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="ChoiceOptionsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChoiceOptionButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding RecommendationReason}"
                                                Opacity="0"
                                                Click="ChoiceOptionButton_Click">
                                            <Button.RenderTransform>
                                                <TranslateTransform Y="8" />
                                            </Button.RenderTransform>
                                            <Button.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="1"
