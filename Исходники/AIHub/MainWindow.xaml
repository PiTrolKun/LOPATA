                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0"
                                Visibility="Collapsed"
                                Click="ExecutorRequestResultButton_Click" />
                    </Grid>
                </Border>

                <Border x:Name="ExecutorResponseDock"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl x:Name="ExecutorClarificationOptionsItemsControl"
                                       Grid.Row="0"
                                       ItemsPanel="{StaticResource ExecutorOptionsWidePanel}"
                                       Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChoiceOptionButtonStyle}"
                                            Tag="{Binding}"
                                            MinHeight="44"
                                            Margin="4"
                                            Padding="10,6"
                                            Click="ExecutorClarificationOptionButton_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{DynamicResource UiFont13}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="{DynamicResource UiFont11}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="ExecutorNextStageButton"
                                Grid.Row="1"
                                Content="Всё верно, начать работу"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="4,8,4,0"
                                Visibility="Collapsed"
                                Click="ExecutorNextStageButton_Click" />

                        <StackPanel x:Name="ExecutorCustomInputPanel"
                                    Grid.Row="2"
                                    Visibility="Collapsed"
                                    Margin="4,10,4,0">
                            <TextBlock x:Name="ExecutorCustomInputHelpText"
                                       Text="Добавьте вопрос, пояснение или важную деталь."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont12}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExecutorCustomInput"
                                         Height="74"
                                         MaxLength="4000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="8" />
                                <Button x:Name="ExecutorCustomSubmitButton"
                                        Grid.Column="1"
                                        Content="Принять"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="36"
                                        MinWidth="110"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Bottom"
                                        Click="ExecutorCustomSubmitButton_Click" />
                            </Grid>
                        </StackPanel>

                        <Button x:Name="ExecutorFinishSessionDockButton"
                                Grid.Row="3"
                                Content="Завершить сессию"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="4,10,4,0"
                                Opacity="0"
                                Visibility="Collapsed"
                                Click="ExecutorFinishSessionButton_Click">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="ExecutorFinishDockTranslateTransform"
                                                    X="36" />
                            </Button.RenderTransform>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BackFromChoiceScenarioButton"
                        Content="Назад"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackFromChoiceScenarioButton_Click" />
                <Button x:Name="CancelChoiceScenarioButton"
                        Content="Отмена"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0"
                        Click="CancelChoiceScenarioButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="28,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Text="Статус: прототип стартового окна. Скачивание моделей и изменение настроек пока не выполняются."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource UiFont12}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="AboutButton" Grid.Column="1" Content="?"
                            Width="22" Height="22" MinWidth="0" MinHeight="0"
                            Padding="0" Margin="12,0,0,0"
                            VerticalAlignment="Center" HorizontalContentAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="AboutButton_Click" />

                    <StackPanel x:Name="CoreMemoryIndicatorPanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Opacity="0.42"
                                ToolTip="Память ядра неактивна">
                        <TextBlock x:Name="CoreMemoryIconText"
                                   Text="🧠"
                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                   FontSize="{DynamicResource UiFont16}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ProgressBar x:Name="CoreMemoryProgressBar"
                                     Width="112"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CoreModelPromptPanel"
                      Visibility="Collapsed"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CoreModelPromptText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource UiFont12}"
                               LineHeight="{DynamicResource UiLineHeight18}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="14,0,0,0">
                        <Button x:Name="DownloadCoreModelButton"
                                Content="Скачать"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="104"
                                Height="34"
                                Click="DownloadCoreModelButton_Click" />
                        <Button x:Name="OpenSetupFromCoreModelButton"
                                Content="Открыть настройки"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="138"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="OpenSetupFromCoreModelButton_Click" />
                        <Button x:Name="PostponeCoreModelButton"
                                Content="Позже"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="86"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="PostponeCoreModelButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CoreModelDownloadPanel"
                      Visibility="Collapsed"
                      Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CoreModelDownloadTitleText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource UiFont12}"
                               TextWrapping="Wrap" />

                    <ProgressBar x:Name="CoreModelDownloadProgressBar"
                                 Grid.Row="2"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0" />

                    <StackPanel Grid.RowSpan="3"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="14,0,0,0">
                        <Button x:Name="PauseCoreModelDownloadButton"
                                Content="Пауза"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="86"
                                Height="34"
                                Click="PauseCoreModelDownloadButton_Click" />
                        <Button x:Name="CancelCoreModelDownloadButton"
                                Content="Отмена"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="86"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="CancelCoreModelDownloadButton_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid x:Name="ChoiceAiActivityPanel"
              Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="1000"
              IsHitTestVisible="False"
              ClipToBounds="True"
              Visibility="Collapsed">
            <Border Background="#80000000" />
            <controls:MatrixRainControl x:Name="ChoiceMatrixRain" />
        </Grid>
    </Grid>
</Window>
