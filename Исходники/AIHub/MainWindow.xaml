                          Margin="0,14,0,0"
                          Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="ViewerComponentsHelpText"
                                   Text="Просмотрщики нужны только интерфейсу и никогда не передаются ядру или исполнителю."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <CheckBox x:Name="PreferInternalViewersCheckBox"
                                  Content="Открывать поддерживаемые файлы внутри ЛОПАТА"
