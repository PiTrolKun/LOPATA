                                   Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="850" HorizontalAlignment="Left" />
                        <Button x:Name="OpenLiteraryDiagnosticsButton" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenLiteraryDiagnostics_Click" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource PanelBrush}"
