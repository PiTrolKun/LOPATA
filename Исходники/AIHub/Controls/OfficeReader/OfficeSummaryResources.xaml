<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TabControl">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{DynamicResource ReaderPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReaderText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReaderLine}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource ReaderText}"/>
        <Setter Property="Background" Value="{DynamicResource ReaderPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReaderLine}"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Margin" Value="3,3,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ReaderHover}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#5388F5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ReaderHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
