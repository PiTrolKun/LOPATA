<Project Sdk="MSTest.Sdk/4.2.3">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LOPATA.Updates\LOPATA.Updates.csproj" />
    <ProjectReference Include="..\LOPATA.UpdateTool\LOPATA.UpdateTool.csproj" />
    <Compile Include="..\LOPATA.Updater\CollectionInstallation.cs" Link="Updater\CollectionInstallation.cs" />
    <None Include="..\LOPATA.Updater\Localization\*.json" Link="UpdaterLocalization\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
