 /// The weights the selected set resolves to, as paths the engine can open.
+// Explicit model paths supplied and integrity checked by the owning LOPATA adapter.
+fn lopata_models() -> Option<music_engine::yue_server::YueModelFiles> {
+    let backbone = PathBuf::from(env::var_os("LOPATA_YUE_BACKBONE")?);
+    let vae = PathBuf::from(env::var_os("LOPATA_YUE_VAE")?);
+    let companion = PathBuf::from(env::var_os("LOPATA_YUE_COMPANION")?);
+    if !backbone.is_file() || !vae.is_file() || !companion.is_file() { return None; }
+    Some(music_engine::yue_server::YueModelFiles { backbone, vae, companion, transcriber: None, adapters: None })
+}
