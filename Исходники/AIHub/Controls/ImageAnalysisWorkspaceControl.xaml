<UserControl x:Class="AIHub.Controls.ImageAnalysisWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="VoiceModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceSurface" Background="Transparent" Padding="3,2">
                            <StackPanel HorizontalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontSize="{DynamicResource UiFont10}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       LineHeight="15" />
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                                <Grid Width="18" Height="18" Margin="0,4,0,0" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" />
                                    <Ellipse x:Name="ChoiceDot" Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="#16253B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VoiceSettingsChevronButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChevronSurface" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChevronSurface" Property="Background" Value="#16253B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChevronSurface" Property="Background" Value="#16253B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChevronSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayout" MaxWidth="1760" Margin="24,14,24,16" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" TextAlignment="Center" FontSize="{DynamicResource UiFont30}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DescriptionText" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont14}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Border x:Name="SelectedImageCard" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Margin="0,11,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="92" Height="58" Background="#0B1220" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True"><Image x:Name="SelectedImagePreview" Stretch="UniformToFill" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,16,0"><TextBlock x:Name="SelectedFileTitleText" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SelectedFileDetailsText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont11}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                <Button Grid.Column="2" x:Name="SelectImageButton" MinWidth="150" Height="38" VerticalAlignment="Center" Style="{DynamicResource SecondaryButtonStyle}" Click="SelectImageButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Margin="0,11,0,0" Padding="6">
            <UniformGrid Columns="4">
                <Border x:Name="SubscenarioStepBorder" CornerRadius="7" Padding="10,7"><StackPanel Orientation="Horizontal"><Border x:Name="SubscenarioStepNumberBorder" Width="26" Height="26" CornerRadius="13"><TextBlock x:Name="SubscenarioStepNumberText" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><StackPanel Margin="9,0,0,0"><TextBlock x:Name="SubscenarioStepTitleText" FontWeight="SemiBold" /><TextBlock x:Name="SubscenarioStepHintText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont11}" /></StackPanel></StackPanel></Border>
                <Border x:Name="ImageStepBorder" CornerRadius="7" Padding="10,7"><StackPanel Orientation="Horizontal"><Border x:Name="ImageStepNumberBorder" Width="26" Height="26" CornerRadius="13"><TextBlock x:Name="ImageStepNumberText" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><StackPanel Margin="9,0,0,0"><TextBlock x:Name="ImageStepTitleText" FontWeight="SemiBold" /><TextBlock x:Name="ImageStepHintText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont11}" /></StackPanel></StackPanel></Border>
                <Border x:Name="SettingsStepBorder" CornerRadius="7" Padding="10,7"><StackPanel Orientation="Horizontal"><Border x:Name="SettingsStepNumberBorder" Width="26" Height="26" CornerRadius="13"><TextBlock x:Name="SettingsStepNumberText" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><StackPanel Margin="9,0,0,0"><TextBlock x:Name="SettingsStepTitleText" FontWeight="SemiBold" /><TextBlock x:Name="SettingsStepHintText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont11}" /></StackPanel></StackPanel></Border>
                <Border x:Name="ResultStepBorder" CornerRadius="7" Padding="10,7"><StackPanel Orientation="Horizontal"><Border x:Name="ResultStepNumberBorder" Width="26" Height="26" CornerRadius="13"><TextBlock x:Name="ResultStepNumberText" Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><StackPanel Margin="9,0,0,0"><TextBlock x:Name="ResultStepTitleText" FontWeight="SemiBold" /><TextBlock x:Name="ResultStepHintText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont11}" /></StackPanel></StackPanel></Border>
            </UniformGrid>
        </Border>

        <Grid x:Name="WorkspaceBody" Grid.Row="3" Margin="0,11,0,0" MinHeight="0">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ActivityColumn" Width="220" /><ColumnDefinition x:Name="CenterColumn" Width="*" /><ColumnDefinition x:Name="ResultColumn" Width="330" /></Grid.ColumnDefinitions>

            <Border x:Name="ActivityPanel" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,11,0" MinHeight="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="ActivityTitleText" Visibility="Collapsed" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,9,0,0" ClipToBounds="False">
                        <Border Width="1" Background="{DynamicResource LineBrush}" HorizontalAlignment="Left" Margin="24,0,0,0" />
                        <ScrollViewer x:Name="EventScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="EventItemsPanel" /></ScrollViewer>
                        <TextBlock x:Name="EventsEmptyText" Opacity="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="10" />
                    </Grid>
                    <StackPanel x:Name="ActivityLegendPanel" Grid.Row="2" Margin="0,9,0,0">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#2AD26C" Margin="0,0,7,0" /><TextBlock x:Name="CoreLegendText" FontSize="{DynamicResource UiFont11}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,7,0" /><TextBlock x:Name="VisionLegendText" FontSize="{DynamicResource UiFont11}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,7,0" /><TextBlock x:Name="LocalizerLegendText" FontSize="{DynamicResource UiFont11}" /></StackPanel>
                    </StackPanel>
                    <Button x:Name="DiagnosticsButton" Grid.Row="2" Width="38" MinWidth="0" Height="38" Padding="0"
                            HorizontalAlignment="Center" Style="{DynamicResource SecondaryButtonStyle}" Click="DiagnosticsButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="18" />
                    </Button>
                    <Expander x:Name="HeavyDiagnosticsExpander"
                              Grid.Row="2"
                              Margin="0,9,0,0"
                              Visibility="Collapsed">
                        <Border BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="7"
                                Margin="0,5,0,0">
                            <TextBox x:Name="HeavyDiagnosticsTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="300"
                                     Padding="5"
                                     FontFamily="Consolas"
                                     FontSize="10" />
                        </Border>
                    </Expander>
                </Grid>
            </Border>

            <Border x:Name="CenterPanel" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,0,11,0" MinHeight="0">
                <Grid>
                    <Grid x:Name="SubscenarioPanel">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                        <TextBlock x:Name="SubscenarioTitleText" FontSize="{DynamicResource UiFont24}" FontWeight="SemiBold" /><TextBlock x:Name="SubscenarioDescriptionText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Border Background="{DynamicResource SecondaryButtonBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SingleScenarioTitleText" TextWrapping="Wrap" Margin="0,0,12,0" FontSize="{DynamicResource UiFont18}" FontWeight="SemiBold" /><TextBlock x:Name="SingleScenarioDescriptionText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,16,0" /></StackPanel><Button Grid.Column="1" x:Name="SingleScenarioButton" MinWidth="160" Height="40" Style="{DynamicResource PrimaryButtonStyle}" Click="SingleScenarioButton_Click" /></Grid></Border>
                        <Border Background="{DynamicResource SecondaryButtonBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="MultipleScenarioTitleText" TextWrapping="Wrap" Margin="0,0,12,0" FontSize="{DynamicResource UiFont18}" FontWeight="SemiBold" /><TextBlock x:Name="MultipleScenarioDescriptionText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,16,0" /></StackPanel><Button Grid.Column="1" x:Name="MultipleScenarioButton" MinWidth="160" Height="40" Style="{DynamicResource SecondaryButtonStyle}" IsEnabled="False" /></Grid></Border>

                        <Border x:Name="HistoryContentBorder"
                                Visibility="Collapsed"
                                Opacity="0"
                                MaxHeight="205"
                                Margin="0,7,0,0"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="HistoryScrollViewer"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <StackPanel>
                                    <StackPanel x:Name="HistoryItemsPanel" />
                                    <TextBlock x:Name="HistoryEmptyText" Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,7,3,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                        <Button x:Name="HistoryToggleButton" Grid.Row="1"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,15,0,0"
                                Padding="11,8"
                                Click="HistoryToggleButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HistoryTitleText" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Viewbox Visibility="Collapsed" Grid.Column="1" Width="18" Height="10" Margin="12,0,2,0" VerticalAlignment="Center">
                                    <Path x:Name="HistoryChevronPath"
                                          Data="M1,1 Q9,9 17,1"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                    </Path>
                                </Viewbox>
                            </Grid>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="ImagePanel" Visibility="Collapsed">
                        <TextBlock x:Name="ImagePanelTitleText" FontSize="{DynamicResource UiFont24}" FontWeight="SemiBold" /><TextBlock x:Name="ImagePanelDescriptionText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button x:Name="SelectImageEmptyButton" MinWidth="190" Height="40" HorizontalAlignment="Left" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,14,0,0" Click="SelectImageButton_Click" />
                        <Border x:Name="FileValidationPanel" Background="#16253B" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="FileValidationText" TextWrapping="Wrap" /></Border>
                        <Button x:Name="ContinueToSettingsButton" MinWidth="190" Height="40" HorizontalAlignment="Right" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,14,0,0" IsEnabled="False" Click="ContinueToSettingsButton_Click" />
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="SettingsPanelTitleText" FontSize="{DynamicResource UiFont24}" FontWeight="SemiBold" /><TextBlock x:Name="SettingsPanelDescriptionText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Grid x:Name="StandardSettingsGrid" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock x:Name="AccuracyLabelText" FontWeight="SemiBold" /><ComboBox x:Name="AccuracyComboBox" Height="36" Margin="0,6,0,0" SelectedIndex="1"><ComboBoxItem Tag="strict" /><ComboBoxItem Tag="balanced" /><ComboBoxItem Tag="free" /></ComboBox></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock x:Name="StyleLabelText" FontWeight="SemiBold" /><ComboBox x:Name="StyleComboBox" Height="36" Margin="0,6,0,0" SelectedIndex="1"><ComboBoxItem Tag="neutral" /><ComboBoxItem Tag="atmospheric" /><ComboBoxItem Tag="dramatic" /><ComboBoxItem Tag="fairy_tale" /></ComboBox></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0"><TextBlock x:Name="LengthLabelText" FontWeight="SemiBold" /><ComboBox x:Name="LengthComboBox" Height="36" Margin="0,6,0,0" SelectedIndex="1"><ComboBoxItem Tag="brief" /><ComboBoxItem Tag="standard" /><ComboBoxItem Tag="detailed" /></ComboBox></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock x:Name="FormLabelText" FontWeight="SemiBold" /><ComboBox x:Name="FormComboBox" Height="36" Margin="0,6,0,0" SelectedIndex="1"><ComboBoxItem Tag="continuous" /><ComboBoxItem Tag="with_title" /></ComboBox></StackPanel>
                        </Grid>
                        <DockPanel Margin="0,16,0,0">
                            <Button x:Name="WishesButton" DockPanel.Dock="Right" MinWidth="0" Width="44" Height="38" Padding="4" Margin="12,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="WishesButton_Click" />
                            <WrapPanel x:Name="PromptModePanel">
                                <Button x:Name="StandardPromptButton" MinHeight="38" Margin="0,0,8,0" Click="StandardPromptButton_Click" />
                                <Button x:Name="CustomPromptButton" MinHeight="38" Click="CustomPromptButton_Click" />
                            </WrapPanel>
                        </DockPanel>
                        <Grid x:Name="CustomPromptPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="PromptPairComboBox" MinHeight="36" DisplayMemberPath="Name" SelectionChanged="PromptPairComboBox_SelectionChanged" />
                            <Button x:Name="CreatePromptPairButton" Grid.Column="1" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" MinWidth="0" Width="42" Height="38" Padding="4" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="CreatePromptPairButton_Click" />
                            <Button x:Name="ManagePromptPairsButton" Grid.Column="2" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" MinWidth="0" Width="42" Height="38" Padding="4" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="ManagePromptPairsButton_Click" />
                        </Grid>
                        <TextBlock x:Name="PromptPairStatusText" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button x:Name="GenerateButton" MinWidth="210" Height="42" HorizontalAlignment="Right" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,14,0,0" Click="GenerateButton_Click" />
                    </StackPanel>

                    <Grid x:Name="ResultEditorPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock x:Name="ResultEditorTitleText" FontSize="{DynamicResource UiFont24}" FontWeight="SemiBold" /><TextBlock x:Name="ResultEditorDescriptionText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                        <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Grid.ColumnSpan="3"><TextBlock x:Name="VersionLabelText" FontWeight="SemiBold" /><ComboBox x:Name="VersionComboBox" Height="36" Margin="0,6,0,0" DisplayMemberPath="DisplayName" SelectionChanged="VersionComboBox_SelectionChanged" /></StackPanel>
                            <Button Grid.Row="1" Grid.Column="0" x:Name="PreviewButton" Height="40" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,10,0,0" IsEnabled="False" Click="PreviewButton_Click" /><Button Grid.Row="1" Grid.Column="2" x:Name="ExportButton" Height="40" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,10,0,0" IsEnabled="False" Click="ExportButton_Click" />
                        </Grid>
                        <StackPanel Grid.Row="2" x:Name="RevisionPanel" Margin="0,13,0,0" VerticalAlignment="Top"><Separator Margin="0,0,0,10" /><TextBlock x:Name="RevisionLabelText" FontWeight="SemiBold" /><TextBox x:Name="RevisionTextBox" MinHeight="62" MaxHeight="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="9" Margin="0,6,0,0" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0"><Button x:Name="ReviseButton" MinWidth="190" Height="40" Style="{DynamicResource PrimaryButtonStyle}" Click="ReviseButton_Click" /><Button x:Name="CancelOperationButton" MinWidth="120" Height="40" Style="{DynamicResource SecondaryButtonStyle}" Margin="9,0,0,0" Visibility="Collapsed" Click="CancelOperationButton_Click" /></StackPanel></StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="CompleteButton" Height="42" Style="{DynamicResource PrimaryButtonStyle}" IsEnabled="False" Click="CompleteButton_Click" /><StackPanel x:Name="CompletedNavigationPanel" Visibility="Collapsed"><Button x:Name="NewAnalysisButton" Height="42" Style="{DynamicResource PrimaryButtonStyle}" Click="NewAnalysisButton_Click" /><Button x:Name="HomeButton" Height="40" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,8,0,0" Click="HomeButton_Click" /></StackPanel></StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ResultPanel" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="0" MinHeight="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,12,12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border x:Name="SpeechIdentityBadge"
                                        Width="40"
                                        Height="40"
                                        Background="#6B7280"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        VerticalAlignment="Top">
                                    <Viewbox Width="21" Height="21">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SpeechIdentityBodyPath" Data="M3,9 L7,9 L12,4 L12,20 L7,15 L3,15 Z" Fill="White" />
                                            <Path x:Name="SpeechIdentityWavesPath" Data="M15,8 C17,10 17,14 15,16 M18,5 C22,9 22,15 18,19" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="VoiceModeTitleText" HorizontalAlignment="Center" FontSize="{DynamicResource UiFont11}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <UniformGrid x:Name="SpeechModeGrid" Grid.Row="1" Grid.ColumnSpan="2" Columns="3" Margin="0,7,0,0">
                                    <RadioButton x:Name="SpeechOffRadioButton" GroupName="ImageAnalysisSpeechMode" Style="{StaticResource VoiceModeRadioStyle}" Checked="SpeechModeRadioButton_Checked" />
                                    <RadioButton x:Name="SpeechOmniRadioButton" GroupName="ImageAnalysisSpeechMode" Style="{StaticResource VoiceModeRadioStyle}" Checked="SpeechModeRadioButton_Checked" Visibility="Collapsed" />
                                    <RadioButton x:Name="SpeechKokoroRadioButton" GroupName="ImageAnalysisSpeechMode" Style="{StaticResource VoiceModeRadioStyle}" Checked="SpeechModeRadioButton_Checked" />
                                    <RadioButton x:Name="SpeechProgrammaticRadioButton" GroupName="ImageAnalysisSpeechMode" Style="{StaticResource VoiceModeRadioStyle}" Checked="SpeechModeRadioButton_Checked" />
                                </UniformGrid>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                                <Button x:Name="KokoroDownloadButton" MinWidth="92" Height="30" Style="{DynamicResource SecondaryButtonStyle}" Visibility="Collapsed" Click="KokoroDownloadButton_Click" />
                                <Button x:Name="ReplaySpeechButton" MinWidth="92" Height="30" Margin="6,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Visibility="Collapsed" Click="ReplaySpeechButton_Click" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" x:Name="VoiceStatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont11}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed" />
                            <StackPanel Grid.Row="3">
                                <Button x:Name="VoiceSettingsToggleButton"
                                        Height="30"
                                        Margin="0,5,0,0"
                                        Style="{StaticResource VoiceSettingsChevronButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="VoiceSettingsToggleButton_Click">
                                    <Path x:Name="VoiceSettingsChevronPath"
                                          Width="88"
                                          Height="15"
                                          Data="M2,2 C24,20 64,20 86,2"
                                          Stretch="Fill"
                                          Stroke="#38BDF8"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                    </Path>
                                </Button>
                                <Border x:Name="VoiceSettingsPanel" Visibility="Collapsed" Opacity="0" Margin="2,6,2,0" Padding="8,8,8,2">
                                    <StackPanel>
                                        <StackPanel x:Name="OmniSpeakerPanel" Visibility="Collapsed" Margin="0,0,0,9">
                                            <TextBlock x:Name="OmniSpeakerLabelText" />
                                            <ComboBox x:Name="OmniSpeakerComboBox" Height="32" Margin="0,5,0,0" SelectionChanged="OmniSpeakerComboBox_SelectionChanged">
                                                <ComboBoxItem Tag="Ethan" />
                                                <ComboBoxItem Tag="Chelsie" />
                                            </ComboBox>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="VoiceVolumeLabelText" VerticalAlignment="Center" />
                                            <TextBlock x:Name="VoiceVolumeValueText" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider x:Name="VoiceVolumeSlider" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,25,0,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="VoiceSettingsSlider_ValueChanged" />
                                            <TextBlock x:Name="VoiceRateLabelText" Grid.Row="1" Margin="0,18,0,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="VoiceRateValueText" Grid.Row="1" Grid.Column="1" Margin="0,18,0,0" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider x:Name="VoiceRateSlider" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,43,0,0" Minimum="70" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="VoiceSettingsSlider_ValueChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="14,12,14,12" MinHeight="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="ResultPanelTitleText" FontWeight="SemiBold" FontSize="{DynamicResource UiFont16}" />
                        <TextBlock Grid.Row="1" x:Name="ResultPanelHintText" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="FindingsEmptyText" Opacity="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><StackPanel x:Name="FindingsItemsPanel" /><StackPanel x:Name="UncertaintiesPanel" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="UncertaintiesTitleText" FontWeight="SemiBold" FontSize="{DynamicResource UiFont12}" /><StackPanel x:Name="UncertaintyItemsPanel" Margin="0,5,0,0" /></StackPanel></StackPanel>
                        <TextBlock Grid.Row="3" x:Name="ReviewSummaryFooterText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont11}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,11,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Height="38" MinWidth="175" Style="{DynamicResource SecondaryButtonStyle}" Click="BackButton_Click" />
            <TextBlock Grid.Column="1" x:Name="FooterStatusText" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="14,0,0,0" />
        </Grid>

        <Popup x:Name="EventDetailPopup" Placement="Right" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MaxWidth="340"><StackPanel><TextBlock x:Name="EventDetailTitleText" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="EventDetailText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /><TextBlock x:Name="EventDetailTimeText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource UiFont11}" Margin="0,6,0,0" /></StackPanel></Border></Popup>
        <Popup x:Name="SpeechErrorPopup" PlacementTarget="{Binding ElementName=ResultPanel}" Placement="Center" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade"><Border Background="#3B1117" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="13" MaxWidth="310"><StackPanel><TextBlock x:Name="SpeechErrorTitleText" Foreground="#FCA5A5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SpeechErrorText" Foreground="White" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border></Popup>
    </Grid>
</UserControl>
