<UserControl x:Class="AIHub.Controls.OfficeTextEditor.OfficeNativeEditorView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource ReaderText}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="145" MaxWidth="290"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,8,0">
            <Button x:Name="AddPageButton" DockPanel.Dock="Bottom" AutomationProperties.AutomationId="Office.Native.AddPage"
                    HorizontalContentAlignment="Left" Click="AddPage"/>
            <ListBox x:Name="Pages" AutomationProperties.AutomationId="Office.Native.Pages"
                 DisplayMemberPath="Label" Padding="3"
                 Background="{DynamicResource ReaderPanel}" Foreground="{DynamicResource ReaderText}"
                 BorderBrush="{DynamicResource ReaderLine}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="SelectPage">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
        <Grid Grid.Column="1" Background="{DynamicResource ReaderPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="PreviewRow" Height="0"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel><DockPanel Margin="6,3" LastChildFill="False">
                <Button x:Name="PreviewButton" DockPanel.Dock="Right" Click="TogglePreview"
                        AutomationProperties.AutomationId="Office.Native.Preview"/>
                <Button x:Name="ReplaceButton" DockPanel.Dock="Right" Click="ReplacePicture" Margin="0,0,6,0"
                        AutomationProperties.AutomationId="Office.Native.ReplacePicture"/>
                <WrapPanel x:Name="Tools">
                <Button x:Name="BoldButton" Content="B" FontWeight="Bold" MinWidth="36"
                        AutomationProperties.AutomationId="Office.Native.Bold" Click="ToggleBold"/>
                <Button x:Name="ItalicButton" Content="I" FontStyle="Italic" MinWidth="36"
                        AutomationProperties.AutomationId="Office.Native.Italic" Click="ToggleItalic"/>
                <ComboBox x:Name="SizeBox" Width="72" VerticalContentAlignment="Center" Margin="4,0"
                          AutomationProperties.AutomationId="Office.Native.FontSize" SelectionChanged="ChangeSize"/>
                </WrapPanel>
            </DockPanel><ContentControl x:Name="ObjectCommands" Margin="4,0"/></StackPanel>
            <TextBlock Grid.Row="1" x:Name="Notice" Margin="12,6" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Border Grid.Row="2" x:Name="PreviewHost" AutomationProperties.AutomationId="Office.Native.PreviewHost"/>
            <ListBox Grid.Row="3" x:Name="Paragraphs" AutomationProperties.AutomationId="Office.Native.Paragraphs"
                     Background="{DynamicResource ReaderPanel}" Foreground="{DynamicResource ReaderText}"
                     BorderBrush="{DynamicResource ReaderLine}" BorderThickness="1" Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="SelectBlock">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="{Binding AllowLineBreaks}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="{Binding Id}" AutomationProperties.Name="{Binding Label}"
                                 FontSize="{Binding Size}" FontWeight="{Binding Weight}" FontStyle="{Binding Style}"
                                 Background="{DynamicResource ReaderPanel}" Foreground="{DynamicResource ReaderText}"
                                 BorderBrush="{DynamicResource ReaderLine}" Padding="8,6" Margin="3,1"
                                 GotKeyboardFocus="FocusBlock"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
