<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Product>LOPATA</Product>
    <Title>LOPATA</Title>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <BookOfficeArchive Condition="'$(BookOfficeArchive)' == '' And '$(Configuration)' == 'Release'">true</BookOfficeArchive>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AIHubVersion Condition="'$(AIHubVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\VERSION').Trim())</AIHubVersion>
    <AIHubNumericVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(AIHubVersion)', '-.*$', ''))</AIHubNumericVersion>
    <Version>$(AIHubVersion)</Version>
    <AssemblyVersion>$(AIHubNumericVersion).0</AssemblyVersion>
    <FileVersion>$(AIHubNumericVersion).0</FileVersion>
    <InformationalVersion>$(AIHubVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Tools\BookSmart\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Runtime\BookConverter\calibre-9.16.0\**\*" Link="BookConverterRuntime\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Tools\book-converter-files.json" LogicalName="AIHub.BookConverterManifest" />
    <Content Include="..\..\Runtime\BookConverter\libreoffice-26.2.4.2\**\*" Condition="'$(BookOfficeArchive)' != 'true'" Exclude="..\..\Runtime\BookConverter\libreoffice-26.2.4.2\*.msi" Link="BookOfficeRuntime\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Runtime\BookConverter\libreoffice-26.2.4.2.bundle.zip" Condition="'$(BookOfficeArchive)' == 'true'" Link="BookOfficeRuntime\libreoffice.bundle.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Tools\book-office-files.json" LogicalName="AIHub.BookOfficeManifest" />
    <Content Include="..\..\Runtime\BookConverter\libreoffice-26.2.4.2\System64\*.dll" Condition="'$(BookOfficeArchive)' != 'true'" Link="BookOfficeRuntime\program\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Runtime\MusicAce\source.zip" Link="MusicAceRuntime\source.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Tools\ace-xl-models.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\..\Runtime\MusicDiffRhythm\source.zip" Link="MusicDiffRhythmRuntime\source.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\diffrhythm2-models.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Runtime\MusicHeartMuLa\source.zip" Link="MusicHeartMuLaRuntime\source.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\heartmula-models.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Tools\heartmula-python-files.json" LogicalName="AIHub.HeartMuLaPythonManifest" />
    <EmbeddedResource Include="Tools\diffrhythm2-python-files.json" LogicalName="AIHub.DiffRhythmPythonManifest" />
    <EmbeddedResource Include="ContentEngineSets\catalog.json" LogicalName="AIHub.EngineSets.Catalog" />
    <Content Include="..\..\Runtime\EngineSets\002\**\*" Link="EngineSets\002\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-x64\*.exe;..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-x64\*.dll;..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-x64\manifest.json;..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-x64\LICENSE-*.txt" Link="MusicRuntime\win-x64\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-cuda128-x64\*.exe;..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-cuda128-x64\*.dll;..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-cuda128-x64\manifest.json;..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-cuda128-x64\LICENSE-*.txt" Link="MusicRuntime\win-cuda128-x64\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Tools\ace-xl-python-files.json" LogicalName="AIHub.AcePythonManifest" />
    <EmbeddedResource Include="Tools\image-generation-manifest.json" LogicalName="AIHub.ImageGenerationManifest" />
    <EmbeddedResource Include="Tools\metadata-exiftool-files.json" LogicalName="AIHub.MetadataExifToolManifest" />
    <Content Include="..\..\Runtime\Metadata\ExifTool-13.59\exiftool-13.59_64\**\*" Link="MetadataRuntime\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Content\ImageGenerationExamples.json" LogicalName="AIHub.ImageGenerationExamples" />
    <Resource Include="Assets\GenerationExamples\*.png" />
    <Content Include="Assets\MusicExamples\*.mp3;Assets\MusicExamples\*.opus">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <ProjectReference Include="..\LOPATA.Updates\LOPATA.Updates.csproj" />
    <ProjectReference Include="..\LOPATA.Capture\LOPATA.Capture.csproj" />
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Speech" Version="10.0.9" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Runtime\Backends\chatllm.cpp\v24\win-x64\imagemagick\magick.exe;..\..\Runtime\Backends\chatllm.cpp\v24\win-x64\imagemagick\*.xml;..\..\Runtime\Backends\chatllm.cpp\v24\win-x64\imagemagick\*.icc;..\..\Runtime\Backends\chatllm.cpp\v24\win-x64\imagemagick\LICENSE.txt;..\..\Runtime\Backends\chatllm.cpp\v24\win-x64\imagemagick\NOTICE.txt"
             Link="ImageUtilityRuntime\ImageMagick\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Runtime\MusicAudio\FFmpeg-8.1\bundle\**\*" Link="MusicAudioRuntime\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Runtime\Capture\FFmpeg-8.1\bundle\**\*" Exclude="..\..\Runtime\Capture\FFmpeg-8.1\bundle\files.json" Link="CaptureRuntime\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="Content\LiteraryTips.*.json" WithCulture="false" />
    <EmbeddedResource Include="Content\FinancialCurrencies.json" WithCulture="false" />
    <EmbeddedResource Include="Content\Music*.json" WithCulture="false" />
    <EmbeddedResource Include="Content\AliceChatDom.js" LogicalName="AIHub.AliceChatDom" />
    <Resource Include="Assets\lopata_brand.png" />
    <Resource Include="Assets\scenario-calibration.png" />
    <Resource Include="Assets\music-rhyme-creative.png" />
    <EmbeddedResource Include="Assets\music-default-cover.png" LogicalName="AIHub.MusicDefaultCover" />
    <Content Include="Licenses\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Installer\bootstrap-v1.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\rag-book-models.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\rag_pdf_render.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\giga-manifest.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\music-lyrics-components.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\yue2-bf16-models.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-cpu-lock.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-cu126-lock.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-cu128-lock.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-rocm721-lock.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-xpu-lock.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-cu126-files.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-cu128-files.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-rocm721-files.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-xpu-files.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\python-hardware-cpu-files.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\image-utility-ai-manifest.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Tools\jelly-*.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\..\Каталоги\huggingface-catalog-seed.json" Link="Catalogs\huggingface-catalog-seed.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Каталоги\Рабочие_паттерны\work-patterns.json" Link="Catalogs\WorkPatterns\work-patterns.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\libespeak-ng.dll" Link="VoiceRuntime\eSpeakNG\libespeak-ng.dll" Condition="Exists('..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\libespeak-ng.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\espeak-ng.exe" Link="VoiceRuntime\eSpeakNG\espeak-ng.exe" Condition="Exists('..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\espeak-ng.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\espeak-ng-data\**\*" Link="VoiceRuntime\eSpeakNG\espeak-ng-data\%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('..\..\Runtime\Voice\eSpeakNG\1.52.0\extracted\eSpeak NG\espeak-ng-data')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CheckMusicRuntime" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('..\..\Runtime\MusicAce\source.zip')" Text="Pinned official ACE source archive is missing. Run Инструменты/MusicAce/pack-source.ps1." />
    <Error Condition="!Exists('..\..\Runtime\EngineSets\002\studio\native\manifest.json') Or !Exists('ContentEngineSets\catalog.json')" Text="Pinned engine set 002 is missing. Follow Инструменты/EngineSets/README.md." />
    <Error Condition="!Exists('..\..\Runtime\MusicAudio\FFmpeg-8.1\bundle\manifest.json')" Text="Music audio bundle is missing. Follow Инструменты/MusicAudioRuntime/README.md." />
    <Error Condition="!Exists('..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-x64\manifest.json') Or !Exists('..\..\Runtime\Backends\yue2.cpp\11c1ecb084329200e22fcb286e252b847442ea5c\win-cuda128-x64\manifest.json')" Text="Pinned YuE2 CPU/CUDA runtimes are missing. Restore the bundles documented in REESTR.md before building LOPATA." />
  </Target>
  <Target Name="CheckCaptureRuntime" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('..\..\Runtime\Capture\FFmpeg-8.1\bundle\ffmpeg.exe') Or !Exists('..\..\Runtime\Capture\FFmpeg-8.1\bundle\provenance.json')"
           Text="Bundled capture runtime is missing. Run Инструменты/prepare-capture-runtime.ps1 before building LOPATA." />
  </Target>
  <Target Name="CheckImageUtilityRuntime" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('..\..\Runtime\Backends\chatllm.cpp\v24\win-x64\imagemagick\magick.exe')"
           Text="Bundled ImageMagick 7.1.2-30 runtime is missing. Restore the pinned runtime documented in REESTR.md before building LOPATA." />
  </Target>
  <Target Name="CheckMetadataRuntime" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('..\..\Runtime\Metadata\ExifTool-13.59\exiftool-13.59_64\exiftool.exe')" Text="Metadata runtime is missing. Run Инструменты/MetadataRuntime/prepare.ps1." />
  </Target>
  <Target Name="CheckBookRuntime" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(BookOfficeArchive)' == 'true' And !Exists('..\..\Runtime\BookConverter\libreoffice-26.2.4.2.bundle.zip')" Text="Bundled office archive is missing. Run python Инструменты/BookConverter/package-office.py." />
    <Error Condition="!Exists('..\..\Runtime\BookConverter\calibre-9.16.0\Calibre Portable\Calibre\ebook-convert.exe')" Text="Bundled calibre is missing. Run Инструменты/BookConverter/prepare.py --prepare before building." />
    <Error Condition="!Exists('..\..\Runtime\BookConverter\libreoffice-26.2.4.2\program\soffice.com') Or !Exists('Tools\book-office-files.json')" Text="Bundled LibreOffice is missing. Run Инструменты/BookConverter/prepare-office.py --prepare before building." />
  </Target>
</Project>
