                                  Checked="PreferInternalViewersCheckBox_Changed"
                                  Unchecked="PreferInternalViewersCheckBox_Changed" />
                        <ItemsControl x:Name="ViewerComponentsItemsControl"
                                      Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanDownload}"
