                                       FontSize="{DynamicResource UiFont13}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,14" />

                            <Grid MaxWidth="760" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="ProfileCityLabelText"
                                           Text="Город"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource UiFont12}" />
                                <TextBox x:Name="ProfileCityInput"
                                         Grid.Row="2"
                                         Height="34"
                                         VerticalContentAlignment="Center" />

                                <TextBlock x:Name="ProfileRegionLabelText"
                                           Grid.Column="2"
                                           Text="Регион"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource UiFont12}" />
                                <TextBox x:Name="ProfileRegionInput"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         Height="34"
                                         VerticalContentAlignment="Center" />

                                <TextBlock x:Name="ProfileCountryLabelText"
                                           Grid.Row="4"
                                           Text="Страна"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource UiFont12}" />
                                <TextBox x:Name="ProfileCountryInput"
                                         Grid.Row="6"
                                         Height="34"
                                         VerticalContentAlignment="Center" />

                                <TextBlock x:Name="ProfileTimezoneLabelText"
                                           Grid.Row="4"
                                           Grid.Column="2"
                                           Text="Часовой пояс"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource UiFont12}" />
                                <TextBox x:Name="ProfileTimezoneInput"
                                         Grid.Row="6"
                                         Grid.Column="2"
                                         Height="34"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="ProfileAnswerPreferencesTitleText"
                                       Text="Предпочитаемые ответы"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont18}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ProfileAnswerPreferencesHelpText"
                                       Text="Выберите, как ЛОПАТА должен чаще строить ответы. Можно отметить несколько вариантов."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,14" />

                            <UniformGrid Columns="2" MaxWidth="760" HorizontalAlignment="Left">
                                <CheckBox x:Name="PreferenceConciseCheckBox"
                                          Content="Кратко и по делу"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,18,10" />
                                <CheckBox x:Name="PreferenceDetailedCheckBox"
                                          Content="Подробно с объяснениями"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,18,10" />
                                <CheckBox x:Name="PreferenceSimpleCheckBox"
                                          Content="Простым языком"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,18,10" />
                                <CheckBox x:Name="PreferenceStepsCheckBox"
                                          Content="По шагам"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,18,10" />
                                <CheckBox x:Name="PreferenceExamplesCheckBox"
                                          Content="С примерами"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,18,10" />
                                <CheckBox x:Name="PreferenceSourcesCheckBox"
                                          Content="С источниками при поиске"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,18,10" />
                                <CheckBox x:Name="PreferenceRisksCheckBox"
                                          Content="Предупреждать о рисках и сомнениях"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,18,10" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="ProfileWorkloadTitleText"
                                       Text="Режим нагрузки"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont18}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ProfileWorkloadHelpText"
                                       Text="Выбор не запрещает другие варианты, но влияет на порядок будущих рекомендаций инструментов."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,14" />

                            <StackPanel MaxWidth="840" HorizontalAlignment="Left">
                                <RadioButton x:Name="WorkloadLightRadio"
                                             GroupName="UserWorkloadMode"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="WorkloadLightTitleText"
                                                   Text="Лёгкий"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="WorkloadLightDescriptionText"
                                                   Text="Стараться держать нагрузку на ПК ниже 80%, чаще выбирать лёгкие модели и простые инструменты."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="WorkloadBalancedRadio"
                                             GroupName="UserWorkloadMode"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="WorkloadBalancedTitleText"
                                                   Text="Оптимальный"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="WorkloadBalancedDescriptionText"
                                                   Text="Режим по умолчанию: подбирать нагрузку под паспорт компьютера."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="WorkloadExtremeRadio"
                                             GroupName="UserWorkloadMode"
                                             Foreground="{DynamicResource TextPrimaryBrush}">
                                    <StackPanel>
                                        <TextBlock x:Name="WorkloadExtremeTitleText"
                                                   Text="Экстрим"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="WorkloadExtremeDescriptionText"
                                                   Text="Допускать тяжёлые варианты примерно до 150% комфортной нагрузки. Может быть медленнее и требовательнее к RAM/VRAM/CPU/GPU."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BackFromProfileButton"
                        Content="Назад"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackFromProfileButton_Click" />
                <Button x:Name="SaveProfileButton"
                        Content="Сохранить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,0,0"
                        Click="SaveProfileButton_Click" />
