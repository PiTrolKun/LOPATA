                                  Unchecked="CoreVoiceSettingChanged" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsCoreVoiceVolumeText"
                                       Text="Громкость"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="CoreVoiceVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="200"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CoreVoiceSlider_ValueChanged" />
                            <TextBlock x:Name="CoreVoiceVolumeValueText"
                                       Grid.Column="2"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsCoreVoiceRateText"
                                       Text="Скорость"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="CoreVoiceRateSlider"
                                    Grid.Column="1"
                                    Minimum="80"
                                    Maximum="240"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CoreVoiceSlider_ValueChanged" />
                            <TextBlock x:Name="CoreVoiceRateValueText"
                                       Grid.Column="2"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Button x:Name="CoreVoiceTestButton"
                                Content="Проверить голос"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,16,0,0"
                                Click="CoreVoiceTestButton_Click" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SettingsCoreAutonomyTitleText"
                                   Text="Самостоятельная работа ядра"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource UiFont18}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsCoreAutonomyHelpText"
                                   Text="Ограничивает только технический поиск, исправление вызовов инструментов и подбор комплекта. Обычные ответы и загрузки этим временем не обрываются."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource UiFont13}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsCoreAutonomyTimeText"
                                       Text="Время самостоятельного поиска ядра"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="CoreAutonomyTimeSlider"
                                    Grid.Column="1"
                                    Minimum="30"
                                    Maximum="180"
                                    TickFrequency="15"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CoreAutonomyTimeSlider_ValueChanged" />
                            <TextBlock x:Name="CoreAutonomyTimeValueText"
                                       Grid.Column="2"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SettingsModelDownloadsTitleText"
                                   Text="Скачивание AI-моделей"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource UiFont18}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsModelDownloadsHelpText"
                                   Text="Большие файлы можно получать несколькими соединениями. Уже сохранённая часть используется повторно."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource UiFont13}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="SettingsModelDownloadConnectionsText"
                                   Text="Одновременные соединения"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource UiFont12}"
                                   Margin="0,14,0,6" />
