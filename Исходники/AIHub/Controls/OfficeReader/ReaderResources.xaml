<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AIHub.Controls.OfficeReader">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ReaderScrollResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ReaderPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource ReaderText}"/>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource ReaderText}"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource ReaderText}"/>
        <Setter Property="Background" Value="{DynamicResource ReaderPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReaderLine}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ReaderHover}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#5388F5"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource ReaderText}"/>
        <Setter Property="Background" Value="{DynamicResource ReaderPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ReaderLine}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="7,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ReaderListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="ReaderPageTemplate"><local:ReaderPageView/></DataTemplate>
</ResourceDictionary>
