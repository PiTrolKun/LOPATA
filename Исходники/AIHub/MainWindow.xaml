                                                <TextBlock Text="{Binding DescriptionText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont12}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,12,0" />
                                                <TextBlock Text="{Binding ExtensionText}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="{DynamicResource UiFont11}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,12,0" />
                                                <TextBlock Text="{Binding Entry.License}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont11}"
                                                           Margin="0,3,12,0" />
                                                <CheckBox Content="{Binding PreferInternalLabel}"
                                                          IsChecked="{Binding PreferInternal}"
                                                          Tag="{Binding}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          Margin="0,8,12,0"
                                                          Checked="ViewerFormatPreferenceCheckBox_Changed"
                                                          Unchecked="ViewerFormatPreferenceCheckBox_Changed" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        MinWidth="150">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDownloading}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="38" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0"
                                                                 Height="8"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding ProgressPercent}"
                                                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                                 VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ProgressText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource UiFont10}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding SizeText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont11}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,3,0,8" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding DownloadLabel}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="10,5"
                                                            Tag="{Binding}"
                                                            IsEnabled="{Binding CanDownload}"
                                                            Click="ComponentDownloadButton_Click" />
                                                    <Button Content="{Binding RemoveLabel}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="10,5"
                                                            Margin="6,0,0,0"
                                                            Tag="{Binding}"
                                                            IsEnabled="{Binding CanRemove}"
                                                            Click="ComponentRemoveButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DownloadSelectedViewersButton"
                                    Content="Скачать выбранные просмотрщики"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="DownloadSelectedViewersButton_Click" />
                            <Button x:Name="DownloadAllViewersButton"
                                    Content="Скачать все просмотрщики"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="DownloadAllViewersButton_Click" />
                            <Button x:Name="VerifyInstalledViewersButton"
                                    Content="Проверить просмотрщики"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="VerifyInstalledViewersButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BackFromSettingsButton"
                        Content="Назад"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BackFromSettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ProfilePage"
              Grid.Row="1"
              Margin="56,44,56,36"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="ProfileTitleText"
                           Text="Профиль пользователя"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{DynamicResource UiFont32}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ProfileDescriptionText"
                           Text="Профиль хранится локально и помогает ЛОПАТА точнее обращаться к вам, учитывать местоположение и подбирать стиль работы."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource UiFont15}"
                           LineHeight="{DynamicResource UiLineHeight24}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="ProfileIdentityTitleText"
                                       Text="Имя или ник"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont18}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ProfileIdentityHelpText"
                                       Text="Нужно для обращения модели к пользователю и будущего указания автора в документах."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,10" />
                            <TextBox x:Name="ProfileDisplayNameInput"
                                     Height="34"
                                     MaxWidth="520"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="ProfileLocationTitleText"
                                       Text="Местоположение"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont18}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ProfileLocationHelpText"
                                       Text="Нужно для ответов, где важны страна, город, регион, часовой пояс или локальный контекст."
