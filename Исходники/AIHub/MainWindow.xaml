                    <StackPanel>
                        <TextBlock x:Name="SettingsInterfaceTitleText"
                                   Text="Интерфейс и окно"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource UiSectionFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsInterfaceHelpText"
                                   Text="ЛОПАТА автоматически подстраивает компоновку, а здесь можно выбрать личный размер текста и поведение окна при запуске."
