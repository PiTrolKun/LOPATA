<UserControl x:Class="AIHub.Controls.StartupBusyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="BusyControl" Focusable="False">
    <Grid Background="#99000000">
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="20" Padding="40,32" MaxWidth="520"
                Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid Width="200" Height="200" Margin="0,0,0,24">
                    <Ellipse Margin="12" Stroke="{DynamicResource LineBrush}" StrokeThickness="12" />
                    <Path Data="M 100,12 A 88,88 0 1 1 12,100" Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock Text="{Binding Message, ElementName=BusyControl}"
                           AutomationProperties.Name="{Binding Message, ElementName=BusyControl}"
                           FontSize="{DynamicResource UiCardTitleFontSize}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
