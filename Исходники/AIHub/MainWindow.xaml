                        <TextBlock x:Name="SettingsCoreVoiceTitleText"
                                   Text="Голос ядра"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource UiFont18}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SettingsCoreVoiceHelpText"
                                   Text="Локальный синтетический голос произносит короткие мысли и вопросы ядра."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource UiFont13}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="SettingsCoreVoiceProviderText"
                                   Text="Читалка"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource UiFont12}"
                                   Margin="0,14,0,6" />
                        <ComboBox x:Name="CoreVoiceProviderComboBox"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="CoreVoiceProviderComboBox_SelectionChanged" />
