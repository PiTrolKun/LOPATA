                <Button x:Name="ApplicationUpdatesButton" Content="Обновления программы" HorizontalAlignment="Left" Margin="0,8,0,8" Click="ApplicationUpdates_Click" />
                <Button x:Name="ComponentLicensesButton" Content="Лицензии компонентов"
                        HorizontalAlignment="Left" Margin="0,8,0,8" Click="ComponentLicensesButton_Click" />
                <TextBlock x:Name="SettingsDescriptionText"
                           Text="Здесь будут общие настройки ЛОПАТА. Сейчас доступен выбор языка интерфейса."
