                        <TextBlock x:Name="ComponentOperationStatusText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Expander>

                <Expander x:Name="ViewerComponentsExpander"
