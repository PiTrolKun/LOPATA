                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="{DynamicResource UiFont11}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,14,0" />
                                                <ProgressBar Height="7"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding ProgressPercent}"
                                                             Margin="0,8,14,0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding ProgressText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="{DynamicResource UiFont11}"
                                                           Margin="0,3,14,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" MinWidth="150">
                                                <Button Content="{Binding DownloadActionText}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanAcquire}"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Click="ManagedModelDownloadButton_Click" />
                                                <Button Content="{Binding VerifyActionText}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanVerify}"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Margin="0,7,0,0"
                                                        Click="ManagedModelVerifyButton_Click" />
                                                <Button Content="{Binding RemoveActionText}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanRemove}"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Margin="0,7,0,0"
                                                        Click="ManagedModelRemoveButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <Expander x:Name="ProcessingComponentsExpander"
