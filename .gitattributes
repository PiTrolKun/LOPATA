* text=auto

.gitattributes text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln text eol=crlf
*.png binary
*.ico binary

LICENSE text eol=lf
VERSION text eol=lf

# Official ACE source and license bytes are pinned by SHA256.
Runtime/MusicAce/** -text -eol -whitespace
Исходники/AIHub/Licenses/texts/ace-*.txt -text -eol -whitespace
Runtime/MusicDiffRhythm/source.zip binary
Исходники/AIHub/Licenses/texts/diff2-*.txt -text -eol -whitespace
Runtime/MusicHeartMuLa/source.zip binary
Исходники/AIHub/Licenses/texts/heartmula-* -text -eol -whitespace
Исходники/AIHub/Tools/heartmula-python-files.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

Инструменты/CaptureRuntime/*.sh text eol=lf

# Pinned hardware manifests/locks are byte contracts, including line endings.
# Their exact upstream/staging bytes must survive Git and fresh checkouts.
Исходники/AIHub/Tools/python-hardware-*-files.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
Исходники/AIHub/Tools/python-hardware-*-lock.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

