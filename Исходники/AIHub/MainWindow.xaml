                                   FontSize="{DynamicResource UiSmallFontSize}"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
