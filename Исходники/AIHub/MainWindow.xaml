<Window x:Class="AIHub.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AIHub.Controls"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ЛОПАТА"
        Width="980"
        Height="640"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        Icon="Assets/AppIcon.ico"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="{DynamicResource UiBodyFontSize}"
        UseLayoutRounding="True">
    <Window.Resources>
        <sys:Double x:Key="UiBodyFontSize">14</sys:Double>
        <sys:Double x:Key="UiSmallFontSize">12</sys:Double>
        <sys:Double x:Key="UiTinyFontSize">11</sys:Double>
        <sys:Double x:Key="UiSectionFontSize">18</sys:Double>
        <sys:Double x:Key="UiCardTitleFontSize">20</sys:Double>
        <sys:Double x:Key="UiPageTitleFontSize">32</sys:Double>
        <sys:Double x:Key="UiHeaderTitleFontSize">18</sys:Double>
        <sys:Double x:Key="UiHeaderSubtitleFontSize">12</sys:Double>
        <sys:Double x:Key="UiButtonFontSize">14</sys:Double>
        <sys:Double x:Key="UiFont10">10</sys:Double>
        <sys:Double x:Key="UiFont10_5">10.5</sys:Double>
        <sys:Double x:Key="UiFont11">11</sys:Double>
        <sys:Double x:Key="UiFont12">12</sys:Double>
        <sys:Double x:Key="UiFont13">13</sys:Double>
        <sys:Double x:Key="UiFont14">14</sys:Double>
        <sys:Double x:Key="UiFont15">15</sys:Double>
        <sys:Double x:Key="UiFont16">16</sys:Double>
        <sys:Double x:Key="UiFont17">17</sys:Double>
        <sys:Double x:Key="UiFont18">18</sys:Double>
        <sys:Double x:Key="UiFont19">19</sys:Double>
        <sys:Double x:Key="UiFont20">20</sys:Double>
        <sys:Double x:Key="UiFont21">21</sys:Double>
        <sys:Double x:Key="UiFont22">22</sys:Double>
        <sys:Double x:Key="UiFont26">26</sys:Double>
        <sys:Double x:Key="UiFont30">30</sys:Double>
        <sys:Double x:Key="UiFont32">32</sys:Double>
        <sys:Double x:Key="UiFont34">34</sys:Double>
        <sys:Double x:Key="UiLineHeight16">16</sys:Double>
        <sys:Double x:Key="UiLineHeight17">17</sys:Double>
        <sys:Double x:Key="UiLineHeight18">18</sys:Double>
        <sys:Double x:Key="UiLineHeight19">19</sys:Double>
        <sys:Double x:Key="UiLineHeight20">20</sys:Double>
        <sys:Double x:Key="UiLineHeight21">21</sys:Double>
        <sys:Double x:Key="UiLineHeight22">22</sys:Double>
        <sys:Double x:Key="UiLineHeight24">24</sys:Double>
        <sys:Double x:Key="UiButtonHeight">40</sys:Double>
        <sys:Double x:Key="UiThemeButtonSize">42</sys:Double>
        <sys:Double x:Key="UiPrimaryButtonMinWidth">156</sys:Double>
        <sys:Double x:Key="UiSecondaryButtonMinWidth">96</sys:Double>
        <sys:Double x:Key="UiMainContentMaxWidth">1480</sys:Double>
        <sys:Double x:Key="UiBundleContentMaxWidth">1900</sys:Double>
        <sys:Double x:Key="UiBundleCardMinHeight">408</sys:Double>
        <sys:Double x:Key="UiPreviousWorkMaxHeight">360</sys:Double>
        <Thickness x:Key="UiPageMargin">56,44,56,36</Thickness>
        <Thickness x:Key="UiImagePageMargin">42,26,42,28</Thickness>
        <Thickness x:Key="UiPanelPadding">20</Thickness>
        <Thickness x:Key="UiCardPadding">24</Thickness>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D6470" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrandBackdropBrush" Color="#DBD7D7" />
        <SolidColorBrush x:Key="LineBrush" Color="#DADDE3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="StepBadgeBrush" Color="#EAF1FF" />
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#F8F8F8" />
        <ItemsPanelTemplate x:Key="ExecutorOptionsWidePanel">
            <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ExecutorOptionsNarrowPanel">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="{DynamicResource UiButtonHeight}" />
            <Setter Property="MinWidth" Value="{DynamicResource UiPrimaryButtonMinWidth}" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="{DynamicResource UiButtonFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="{DynamicResource UiButtonHeight}" />
            <Setter Property="MinWidth" Value="{DynamicResource UiSecondaryButtonMinWidth}" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="{DynamicResource UiButtonFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="#C9CDD4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="{DynamicResource UiThemeButtonSize}" />
            <Setter Property="Height" Value="{DynamicResource UiThemeButtonSize}" />
            <Setter Property="MinWidth" Value="{DynamicResource UiThemeButtonSize}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI" />
            <Setter Property="FontSize" Value="{DynamicResource UiCardTitleFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ChoiceOptionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource StepBadgeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExecutorAction}" Value="True">
                    <Setter Property="Background" Value="#173B29" />
                    <Setter Property="BorderBrush" Value="#43D17D" />
                    <Setter Property="BorderThickness" Value="2" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="ExecutorActionPulse">
                            <Storyboard RepeatBehavior="Forever"
                                        AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.84"
                                                 To="1"
                                                 Duration="0:0:1.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="ExecutorActionPulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="7"
                            Background="#1D4ED8">
                        <TextBlock Text="AI"
                                   Foreground="White"
                                   FontSize="{DynamicResource UiFont13}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock x:Name="HeaderProductNameText"
                                   Text="ЛОПАТА"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource UiHeaderTitleFontSize}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderSubtitleText"
                                   Text="Локальная AI-мастерская для Windows"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource UiHeaderSubtitleFontSize}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="ProfileButton"
                            Content="👤"
                            Style="{StaticResource ThemeButtonStyle}"
                            ToolTip="Профиль пользователя"
                            Margin="0,0,10,0"
                            Click="ProfileButton_Click" />
                    <Button x:Name="ApplicationUpdateNotice" Content="Доступно обновление" Visibility="Collapsed" Click="ApplicationUpdates_Click" Margin="0,0,8,0" />
                    <Button x:Name="SettingsButton"
                            Content="⚙"
                            Style="{StaticResource ThemeButtonStyle}"
                            ToolTip="Открыть настройки"
                            Margin="0,0,10,0"
                            Click="SettingsButton_Click" />
                    <Button x:Name="GlobalFileViewerButton"
                            Content="⌕"
                            Style="{StaticResource ThemeButtonStyle}"
                            ToolTip="Просмотреть локальный файл"
                            Margin="0,0,10,0"
                            Click="GlobalFileViewerButton_Click"
                            AutomationProperties.Name="Просмотреть локальный файл" />
                    <Button x:Name="SessionTreeButton"
                            Content="🌳"
                            Style="{StaticResource ThemeButtonStyle}"
                            ToolTip="Дерево текущей сессии"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="SessionTreeButton_Click" />
                    <Button x:Name="ThemeToggleButton"
                            Content="☾"
                            Style="{StaticResource ThemeButtonStyle}"
                            ToolTip="Переключить на тёмную тему"
                            Click="ThemeToggleButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BrandBackdropBrush}"
                IsHitTestVisible="False"
                Visibility="{Binding Visibility, ElementName=WelcomePage}" />
        <Grid x:Name="WelcomePage" Grid.Row="1" Margin="56,44,56,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.4*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Viewbox Stretch="Uniform" Margin="0,0,18,20">
                    <Border Width="1440" Height="1080" CornerRadius="32"
                            Background="{DynamicResource BrandBackdropBrush}">
                        <Image x:Name="HomeBrandImage" Source="Assets/lopata_brand.png"
                               Stretch="Uniform" Margin="16"
                               AutomationProperties.Name="ЛОПАТА / LOPATA" />
                    </Border>
                </Viewbox>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Bottom">
                <TextBlock x:Name="HomeWelcomeTitleText"
                           Text="Добро пожаловать"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{DynamicResource UiFont34}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="HomeHeadlineText"
                           Text="Подготовим место для локального ИИ"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{DynamicResource UiFont20}"
                           FontWeight="SemiBold"
                           Margin="0,14,0,0" />
                <TextBlock x:Name="HomeDescriptionText"
                           Text="ЛОПАТА будет хранить модели, результаты и служебные файлы на выбранных дисках. Сейчас ничего не скачивается и не меняется без вашего подтверждения."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource UiFont15}"
                           LineHeight="{DynamicResource UiLineHeight24}"
                           TextWrapping="Wrap"
                           Margin="0,12,18,0" />

                <WrapPanel Margin="0,24,0,0">
                    <Button x:Name="PrimaryActionButton"
                            Content="Начать настройку"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="PrimaryActionButton_Click" />
                    <Button x:Name="ReconfigureButton"
                            Content="Перенастроить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="124"
                            Margin="12,0,0,0"
                            Click="ReconfigureButton_Click" />
                </WrapPanel>
            </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="WhatWillBeConfiguredTitleText"
                               Text="Что будет настроено"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{DynamicResource UiFont18}"
                               FontWeight="SemiBold" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource StepBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="1"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="{DynamicResource UiFont14}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ModelsStorageTitleText"
                                       Text="Хранилище моделей"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont15}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ModelsStorageStepText"
                                       Text="Выберем диск и лимит для будущих скачиваний."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource StepBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="2"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="{DynamicResource UiFont14}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ResultsStorageTitleText"
                                       Text="Папка результатов"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont15}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ResultsStorageStepText"
                                       Text="Отделим созданные файлы от моделей и кэша."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource StepBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="3"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="{DynamicResource UiFont14}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ComputerPassportTitleText"
                                       Text="Паспорт компьютера"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont15}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ComputerPassportStepText"
                                       Text="Посмотрим RAM, GPU, VRAM и свободное место."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont13}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SetupPage"
              Grid.Row="1"
              Margin="56,44,56,36"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="SetupTitleText"
                           Text="Настройка ЛОПАТА"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{DynamicResource UiFont32}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SetupDescriptionText"
                           Text="Это подготовительная страница будущего мастера настройки. Сейчас программа только создаёт паспорт компьютера и не меняет системные настройки."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource UiFont15}"
                           LineHeight="{DynamicResource UiLineHeight24}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SetupPriorityHintText"
                               Text="Первый адрес используется по умолчанию. Остальные можно будет выбрать вручную там, где это потребуется."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{DynamicResource UiFont13}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="SetupModelsTitleText"
                                       Text="Хранилище моделей"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{DynamicResource UiFont18}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SetupModelsHelpText"
                                       Text="Добавьте путь вручную или выберите папку Windows. Поле рядом — лимит этого адреса в ГБ."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource UiFont12}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ModelsAddressLabelText"
                                           Text="Адрес хранения"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource UiFont12}" />
                                <TextBlock x:Name="ModelsLimitLabelText"
                                           Grid.Column="1"
                                           Text="Лимит адреса, ГБ"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource UiFont12}"
                                           Margin="8,0,0,0" />
                                <TextBox x:Name="ModelsPathInput"
                                         Grid.Row="2"
                                         Height="34"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Можно вставить или написать путь вручную" />
                                <TextBox x:Name="ModelsLocationLimitInput"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Height="34"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Лимит этого адреса в ГБ" />
                                <Button x:Name="BrowseModelsLocationButton"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Content="Выбрать"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="92"
                                        Margin="8,0,0,0"
                                        Click="BrowseModelsLocationButton_Click" />
                                <Button x:Name="AddModelsLocationButton"
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Content="Добавить"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="94"
                                        Margin="8,0,0,0"
                                        Click="AddModelsLocationButton_Click" />
                            </Grid>
                            <ListBox x:Name="ModelsLocationList"
                                     Height="82"
                                     Margin="0,10,0,0"
                                     SelectionChanged="ModelsLocationList_SelectionChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="MoveModelsLocationUpButton"
                                        Content="Вверх"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="MoveModelsLocationUpButton_Click" />
                                <Button x:Name="MoveModelsLocationDownButton"
                                        Content="Вниз"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="MoveModelsLocationDownButton_Click" />
                                <Button x:Name="RemoveModelsLocationButton"
                                        Content="Удалить"
